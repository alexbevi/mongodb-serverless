{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // rootDir spans both directories so the shared plugin contract compiles
    // into this package's own dist. It is not published, so the driver cannot
    // depend on it at runtime.
    "rootDir": "..",
    "outDir": "dist",
    // Outside dist, so build metadata stays out of the published tarball.
    "tsBuildInfoFile": "../tsconfig.driver.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "../plugins/shared/src/**/*.ts"]
}
