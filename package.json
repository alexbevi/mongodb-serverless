{
  "name": "mongodb-serverless-driver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "npm run build && vitest run integration.test.ts --testTimeout=60000",
    "test:watch": "vitest",
    "cluster:stop": "docker rm -f mongodb-serverless-driver-test-rs",
    "typecheck": "tsc --build && pnpm examples:typecheck",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "benchmark": "npm run benchmark:build && node benchmark/local.mjs",
    "benchmark:test": "npm run benchmark:build && vitest run --config vitest.benchmark.config.ts",
    "benchmark:build": "tsc --build benchmark",
    "benchmark:no-monitoring": "npm run build && tsx tools/benchmarks/no-monitoring.ts",
    "test:no-monitoring:package": "tsx tools/verify-no-monitoring-package.ts",
    "examples:typecheck": "pnpm --filter './examples/*' typecheck",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1146.0",
    "@aws-sdk/client-lambda": "3.1146.0",
    "@aws-sdk/client-ssm": "3.1146.0",
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^22.10.2",
    "esbuild": "0.28.2",
    "mongodb": "7.7.0",
    "mongodb-connection-string-url": "^7.0.2",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
