{
  "name": "@mongodb-serverless/driver",
  "version": "0.1.1",
  "description": "Drop-in MongoDB driver wrapper that routes reads and writes to pre-discovered replica set members",
  "type": "module",
  "main": "./dist/driver/src/index.js",
  "types": "./dist/driver/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/driver/src/index.d.ts",
      "default": "./dist/driver/src/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "generate": "node scripts/generate-reexports.mjs",
    "prepack": "npm run generate && tsc --build"
  },
  "dependencies": {
    "mongodb-connection-string-url": "^7.0.2"
  },
  "peerDependencies": {
    "mongodb": ">=7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexbevi/mongodb-serverless.git",
    "directory": "driver"
  },
  "license": "MIT",
  "homepage": "https://github.com/alexbevi/mongodb-serverless#readme",
  "bugs": {
    "url": "https://github.com/alexbevi/mongodb-serverless/issues"
  }
}
